# Copy this file to .env before running the project.
# When Python runs on the host, MYSQL_HOST must remain 127.0.0.1.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=scrapyhub
MYSQL_PASSWORD=scrapyhub
MYSQL_DATABASE=hot_list
MYSQL_CHARSET=utf8mb4

# Scrapy log level: DEBUG, INFO, WARNING, or ERROR
LOG_LEVEL=INFO
